@using eShop.CoreBusiness.Models

@if (Order != null)
{
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">Order Summary</h5>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
                <span>Total Items:</span>
                <span class="fw-bold">@Order.TotalItems</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span>Subtotal:</span>
                <span>@Order.TotalPrice.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
            </div>
            <div class="d-flex justify-content-between mb-3 text-success">
                <span>Shipping:</span>
                <span>FREE</span>
            </div>
            <hr />
            <div class="d-flex justify-content-between fs-5 fw-bold mb-3">
                <span>Grand Total:</span>
                <span class="text-danger">@Order.TotalPrice.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
            </div>
            <NavLink href="checkout" class="btn btn-success w-100 py-2">
                <span class="oi oi-check"></span> Proceed to Checkout
            </NavLink>
        </div>
    </div>
}

@code {
    [Parameter]
    public Order? Order { get; set; }
}
