@page "/checkout"
@page "/placeorder"
@using System.ComponentModel.DataAnnotations
@using eShop.CoreBusiness.Models
@using eShop.UseCases.ShoppingCartScreen
@inject IViewShoppingCartUseCase viewShoppingCartUseCase
@inject IPlaceOrderUseCase placeOrderUseCase
@inject NavigationManager navigationManager

<h3>Checkout & Place Order</h3>
<hr />

@if (order == null)
{
    <p><em>Loading checkout...</em></p>
}
else if (order.LineItems == null || order.LineItems.Count == 0)
{
    <div class="alert alert-warning py-4 text-center">
        <h5>Your shopping cart is empty!</h5>
        <p class="text-muted">You cannot place an order without items.</p>
        <NavLink href="products" class="btn btn-primary mt-2">Go Shopping</NavLink>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-7">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Customer Information</h5>
                </div>
                <div class="card-body">
                    <EditForm Model="order" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label class="form-label">Full Name *</label>
                            <InputText class="form-control" @bind-Value="order.CustomerName" placeholder="Enter customer full name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Street Address *</label>
                            <InputText class="form-control" @bind-Value="order.CustomerAddress" placeholder="123 Main St, Apartment/Suite" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">City *</label>
                                <InputText class="form-control" @bind-Value="order.CustomerCity" placeholder="City" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">State / Province</label>
                                <InputText class="form-control" @bind-Value="order.CustomerStateProvince" placeholder="State/Province" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Country *</label>
                            <InputText class="form-control" @bind-Value="order.CustomerCountry" placeholder="Country" />
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100 py-2">
                            <span class="oi oi-check"></span> Submit Order (@order.TotalPrice.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US")))
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Order Summary (@order.TotalItems items)</h5>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in order.LineItems)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <div class="fw-semibold">@item.Product?.Name</div>
                                    <small class="text-muted">Qty: @item.Quantity × @item.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</small>
                                </div>
                                <span class="fw-bold">@item.Total.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between fs-5 fw-bold text-danger">
                        <span>Total:</span>
                        <span>@order.TotalPrice.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                    </div>
                </div>
            </div>

            <NavLink href="cart" class="btn btn-outline-secondary w-100">
                <span class="oi oi-arrow-left"></span> Back to Shopping Cart
            </NavLink>
        </div>
    </div>
}

@code {
    private Order? order;

    protected override async Task OnInitializedAsync()
    {
        order = await viewShoppingCartUseCase.ExecuteAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            order = await viewShoppingCartUseCase.ExecuteAsync();
            StateHasChanged();
        }
    }

    private async Task HandleValidSubmit()
    {
        if (order != null && order.IsValid())
        {
            var uniqueId = await placeOrderUseCase.ExecuteAsync(order);
            if (!string.IsNullOrEmpty(uniqueId))
            {
                navigationManager.NavigateTo($"orderconfirm/{uniqueId}");
            }
        }
    }
}
