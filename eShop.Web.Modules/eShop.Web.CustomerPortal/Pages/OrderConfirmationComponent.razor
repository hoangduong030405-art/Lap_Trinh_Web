@page "/orderconfirm/{UniqueId}"

@inject IViewOrderConfirmationUseCase viewOrderConfirmationUseCase

@if (order != null)
{
    <div class="confirmation-card">
        <div class="confirmation-header">
            <div class="bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center mx-auto mb-3 shadow" style="width: 72px; height: 72px;">
                <i class="bi bi-check-lg fs-1"></i>
            </div>
            <h1 class="h3 fw-bold text-success-emphasis mb-2">Order Confirmed!</h1>
            <p class="text-secondary mb-3">Thank you for shopping with eShop. Your order has been placed successfully.</p>
            
            <div>
                <span class="text-muted small d-block mb-1">ORDER REFERENCE CODE</span>
                <span class="order-badge-pill">
                    <i class="bi bi-upc-scan"></i> @order.UniqueId
                </span>
            </div>
        </div>

        <div class="p-4 p-md-5">
            <div class="card p-4 rounded-4 bg-light border-0 mb-4">
                <h3 class="h6 fw-bold text-uppercase text-muted mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-person-check text-primary"></i> Customer & Delivery Details
                </h3>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Customer Name</small>
                        <strong class="text-dark">@order.CustomerName</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Street Address</small>
                        <strong class="text-dark">@order.CustomerAddress</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">City, State</small>
                        <strong class="text-dark">@order.CustomerCity, @order.CustomerStateProvince</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Country</small>
                        <strong class="text-dark">@order.CustomerCountry</strong>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <h3 class="h5 fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-box-seam text-primary"></i> Purchased Items
                    </h3>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Item</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.LineItems)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                @if (!string.IsNullOrEmpty(item.Product?.ImageLink))
                                                {
                                                    <img src="@item.Product.ImageLink" style="width: 50px; height: 50px; object-fit: contain;" class="rounded border p-1 bg-white" alt="@item.Product.Name" />
                                                }
                                                <div>
                                                    <div class="fw-bold text-dark">@item.Product?.Name</div>
                                                    <small class="text-muted">@item.Product?.Brand</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center fw-semibold">@item.Quantity</td>
                                        <td class="text-end text-muted">@item.Price.ToString("c")</td>
                                        <td class="text-end fw-bold text-dark">@((item.Price * item.Quantity).ToString("c"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-4">
                        <NavLink href="/products" class="btn-modern-primary">
                            <i class="bi bi-arrow-left"></i> Return to Shopping
                        </NavLink>
                    </div>
                </div>

                <div class="col-lg-4">
                    <OrderSummaryComponent Order="order" HidePlaceOrder="true" />
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card p-5 text-center rounded-4 shadow-sm border-0 my-4">
        <div class="spinner-border text-primary mx-auto mb-3" role="status"></div>
        <p class="text-muted mb-0">Retrieving order details...</p>
    </div>
}

@code {
    private Order? order;

    [Parameter]
    public string UniqueId { get; set; } = string.Empty;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!string.IsNullOrWhiteSpace(UniqueId))
        {
            order = viewOrderConfirmationUseCase.Execute(UniqueId);
        }
    }
}
